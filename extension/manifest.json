{
  "manifest_version": 3,
  "name": "All Media Downloader",
  "version": "1.1.0",
  "description": "Save every photo on a social media profile or post you're viewing. Uses your own login. Nothing is sent anywhere else.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save photos from this profile",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "minimum_chrome_version": "116"
}
